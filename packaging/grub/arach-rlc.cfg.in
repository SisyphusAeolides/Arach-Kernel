set default=0
set timeout=5

menuentry 'ArachOS RLC — Arach Kernel (experimental)' --class arachos --class gnu-linux {
    insmod all_video
    insmod video_bochs
    insmod video_cirrus
    set gfxpayload=keep
    multiboot2 /boot/arach arach.rlc=1 init=/usr/lib/rustd/rustd
    module2 /boot/rustd rustd
    module2 /boot/bootstrap crest
@RESOLVED_MODULE@
    boot
}
